# Local virtual environment
.venv/
__pycache__/
.pytest_cache/

# Downloaded pretrained models (fetched automatically on first run)
models/pose_landmarker_lite.task
*.pt
!models/hub_yolo.pt

# Your personal record
data/best_score.json

# Raw photos (the resized, labeled copies in data/hub_yolo/ are committed)
hub_photos/
# YOLO training logs (best weights are copied to models/hub_yolo.pt)
runs/

# Roboflow downloads (import_roboflow.py copies them into data/hub_yolo/)
*.yolov8/
*.yolov8.zip
